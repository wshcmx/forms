{
  "name": "@wshcmx/forms",
  "version": "0.1.0",
  "description": "Standalone SPXML form parsing and inheritance resolution",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./documents": {
      "types": "./dist/document-xml.d.ts",
      "import": "./dist/document-xml.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
    "test": "node --test tests/*.test.ts",
    "verify:package": "node --test tests/package.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2"
  }
}